{
  "name": "ugtp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --ip 0.0.0.0 --port 8787",
    "db:local": "wrangler d1 migrations apply ugtp --local",
    "db:remote": "wrangler d1 migrations apply ugtp --remote",
    "test:e2e": "node tests/e2e.mjs",
    "bundle": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
